    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "email",
      "value": "student@example.com"
    },
    {
      "key": "password",
      "value": "StudentPassword123!"
    },
    {
      "key": "verificationCode",
      "value": "000000"
    },
    {
      "key": "equipmentId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    },
    {
      "key": "maintenanceId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "technicianId",
      "value": ""
    }
