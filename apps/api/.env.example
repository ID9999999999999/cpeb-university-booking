# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/university_equipment_booking?schema=public"

# API runtime
PORT=3000
NODE_ENV=development

# JWT authentication
# Production requires at least 32 characters.
JWT_SECRET="replace-with-a-long-random-development-secret"
JWT_EXPIRES_IN_SECONDS=7200

# SMTP email verification
# For the committee build this must be a real, externally reachable SMTP account
# with a sender address/domain accepted by the provider.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-user@example.com"
SMTP_PASSWORD="replace-with-your-smtp-password"
MAIL_FROM="CPEB University Booking <your-smtp-user@example.com>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

# Explicit local-test escape hatch only. Never enable in production.
# When true AND NODE_ENV is not production, registration responses may include
# the generated verification code to make automated tests deterministic.
CPEB_DEV_SHOW_VERIFICATION_CODE=false

# Optional browser origins, comma-separated. Android clients are not affected by CORS.
CORS_ORIGINS="http://localhost:3000"

# Optional administrative seed credentials.
# Required only when running: npm run seed:admin
CPEB_ADMIN_EMAIL="admin@university.test"
CPEB_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
CPEB_TECHNICIAN_EMAIL="technician@university.test"
CPEB_TECHNICIAN_PASSWORD="replace-with-a-strong-technician-password"
